{
  "name": "iron-giant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "iron-giant": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc6 && tsc-alias",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "sandbox:build": "tsc6 --project e2b/tsconfig.json && tsx e2b/build.ts",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "latest",
    "drizzle-kit": "^0.31.10",
    "e2b": "2.46.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.3",
    "tsx": "latest",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  }
}
